library(latex2exp)
library(dplyr)
#You only need to specify these once, I like to put them at the top of my plotting code
colblind_safe_palette = c("#009E73",
"#CC79A7",
"#56B4E9",
"#F0E442",
"#D55E00",
"#0072B2")
dat$n <- factor(dat$n, levels = c(200, 500))
dat$meanA <- factor(dat$meanA, levels = c(0, 5, 10))
dat$meanB <- factor(dat$meanB, levels = c(0, 5, 10))
dat$meanC <- factor(dat$meanC, levels = c(0, 5, 10))
dat$beta_lin <- factor(dat$beta_lin, levels =  c(0,1))
dat$beta_con <- factor(dat$beta_con, levels =  c(0,1))
#dat$beta_ab <- factor(dat$beta_ab, levels =  c(0,1))
dat$beta_ab = as.numeric(as.character(dat$beta_ab))
dat$func <- factor(dat$func, levels =   c("quad", "inter", "log"))
dat$beta_non <- factor(dat$beta_non, levels = c(-1, 1))
dat$Method_Name <- factor(dat$Method_Name)
custom_labeller <- labeller(
beta_lin = as_labeller(c(
`0` = "beta[lin] == 0",
`1` = "beta[lin] == 1"
),
label_parsed),
Method_Name = label_parsed
)
sensAC2q <- dat %>%
filter(n == 200 & func == "quad" & meanA == 0 & meanB == 0 & meanC == 0, analysis_group == "AC" & beta_non == 1)
ggplot(sensAC2q, aes(x = beta_ab, y = Sensitivity, color = group, linetype = beta_con, group = interaction(group, beta_lin, beta_con))) +
geom_line() +
geom_point(position = position_dodge(width = 0.3), size = 2) +
ylab(TeX(r"(Sensitivity)")) +
labs(
x = TeX(r"($\beta_{AB}$)"),
color = TeX(r"(Group)"),
linetype = TeX(r"($\beta_{con}$)"),
title = TeX(r"(A. Sensitivity for quadratic AC edge)")
) +
facet_grid(beta_lin ~ Method_Name, labeller = custom_labeller) +
ylim(c(0, 1)) +
scale_x_continuous(breaks = c(0, 1))+
scale_color_manual(values = colblind_safe_palette) +
scale_fill_manual(values = colblind_safe_palette) +
theme(
axis.text = element_text(color = "black", size = 12),
axis.title = element_text(size = 14),
strip.text = element_text(size = 10),
legend.title = element_text(size = 14),
legend.text = element_text(size = 12),
panel.background = element_rect(fill = "white", colour = "black", linewidth = 0.5, linetype = "solid"),
panel.grid.major = element_line(linewidth = 0.5, linetype = 'solid', colour = "white"),
panel.grid.minor = element_line(linewidth = 0.25, linetype = 'solid', colour = "white")
)
# Save the plot
ggsave("./Figures/Figures_RR/Figure1NEWA_3node.png", width = 12, height = 6, units = "in", dpi = "retina")
