multi_df1 <- data.frame(
"Time"         = datmulti1[,"dtime"],
"True PA"      = datmulti1[,"X1"],
"True NA"      = datmulti1[,"X2"],
"Estimated PA" = burstcook1@eta_smooth_final[1,],
"Estimated NA" = burstcook1@eta_smooth_final[2,]
)
multi_df2 <- data.frame(
"Time"         = datmulti2[,"dtime"],
"True PA"      = datmulti2[,"X1"],
"True NA"      = datmulti2[,"X2"],
"Estimated PA" = burstcook2@eta_smooth_final[1,],
"Estimated NA" = burstcook2@eta_smooth_final[2,]
)
plot_multi1_df <- multi_df1 %>%
pivot_longer(cols = -Time, names_to = "series", values_to = "value") %>%
mutate(
Affect = case_when(
grepl("PA", series, ignore.case = TRUE) ~ "P.A.",
grepl("NA", series, ignore.case = TRUE) ~ "N.A.",
TRUE ~ "Other"
),
Type = case_when(
grepl("^True", series, ignore.case = TRUE)      ~ "true",
grepl("^Estimated", series, ignore.case = TRUE) ~ "est",
TRUE ~ "est"
)
) %>%
mutate(
Affect = factor(Affect, levels = c("P.A.", "N.A.")),
Type   = factor(Type,   levels = c("est", "true"))
)
plot_multi2_df <- multi_df2 %>%
pivot_longer(cols = -Time, names_to = "series", values_to = "value") %>%
mutate(
Affect = case_when(
grepl("PA", series, ignore.case = TRUE) ~ "P.A.",
grepl("NA", series, ignore.case = TRUE) ~ "N.A.",
TRUE ~ "Other"
),
Type = case_when(
grepl("^True", series, ignore.case = TRUE)      ~ "true",
grepl("^Estimated", series, ignore.case = TRUE) ~ "est",
TRUE ~ "est"
)
) %>%
mutate(
Affect = factor(Affect, levels = c("P.A.", "N.A.")),
Type   = factor(Type,   levels = c("est", "true"))
)
p1 <- ggplot(plot_multi1_df, aes(x = Time, y = value)) +
geom_line(aes(color = Affect, linetype = Type), linewidth = 1) +
scale_color_manual(
values = c("P.A." = "#009E73", "N.A." = "#CC79A7"),
labels = c("P.A." = "PA",       "N.A." = "NA")
) +
scale_linetype_manual(
values = c(est = "solid", true = "dotted"),
labels = c(est = "Estimated", true = "True")
) +
labs(x = "Time", y = "State Value", color = NULL, linetype = NULL) +
theme_classic(base_size = 14) +
theme(
axis.title.x = element_text(color = "black"),
axis.title.y = element_text(color = "black"),
axis.text.x  = element_text(color = "black"),
axis.text.y  = element_text(color = "black"),
panel.grid   = element_blank(),
legend.position   = "bottom",
legend.direction  = "horizontal",
legend.box.margin = margin(0, 0, 0, 0),
legend.margin     = margin(0, 0, 0, 0),
plot.margin       = margin(5.5, 5.5, 5.5, 5.5, unit = "pt")
) +
guides(
color = guide_legend(nrow = 1, byrow = TRUE),
linetype = guide_legend(nrow = 1, byrow = TRUE)
) +
geom_hline(yintercept = 0, inherit.aes = FALSE, show.legend = FALSE)
p2 <- ggplot(plot_multi2_df, aes(x = Time, y = value)) +
geom_line(aes(color = Affect, linetype = Type), linewidth = 1) +
scale_color_manual(
values = c("P.A." = "#009E73", "N.A." = "#CC79A7"),
