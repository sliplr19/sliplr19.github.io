library(gridExtra)
library(grid)
library(gtable)
g_legend <- function(p) {
g <- ggplotGrob(p)
idx <- which(sapply(g$grobs, function(x) x$name) == "guide-box")
if (length(idx) == 0) stop("No legend found; ensure show.legend = TRUE in the plot.")
g$grobs[[idx]]
}
legend_plot <- ggplot(plot_multi1_df, aes(Time, value, color = Affect, linetype = Type)) +
geom_line(show.legend = TRUE) +
scale_color_manual(values = c("P.A." = "#009E73", "N.A." = "#CC79A7"),
labels = c("P.A." = "PA", "N.A." = "NA")) +
scale_linetype_manual(values = c(est = "solid", true = "dotted"),
labels = c(est = "Estimated", true = "True")) +
guides(color = guide_legend(nrow = 1), linetype = guide_legend(nrow = 1)) +
theme_minimal(base_size = 14) +
theme(legend.position = "bottom",
legend.box.margin = margin(0,0,0,0),
legend.margin     = margin(0,0,0,0))
shared_legend <- g_legend(legend_plot)
p1_noleg <- p1 + labs(y = NULL) + theme(legend.position = "none")
p2_noleg <- p2 + labs(y = NULL) + theme(legend.position = "none")
g1 <- ggplotGrob(p1_noleg)
g2 <- ggplotGrob(p2_noleg)
final_plot_grob <- gridExtra::arrangeGrob(
grobs = list(g1, g2, shared_legend),
ncol = 1,
heights = grid::unit.c(unit(1, "null"), unit(1, "null"), grobHeight(shared_legend)),
left = grid::textGrob("State Value", rot = 90, gp = gpar(fontsize = 14), vjust = 0.5)
)
grid::grid.newpage()
grid::grid.draw(final_plot_grob)
