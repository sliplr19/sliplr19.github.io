}
else{
frac = frac - .2
money = money + 225000*frac*.13
if(frac > 0){
money = money + 225000*frac*.16
}
}
}}
}
return(money)
cash <- function(frac){
if(frac <= .4){
money = 225000*frac*.07
}
else{
frac = frac - .4
money = 225000*.4*.07
if(frac <= .3){
money = money + 225000*frac*.1
}
else{
frac = frac - .3
money = money + 225000*frac*.1
if(frac <= .2){
money = money + 225000*frac*.13
}
else{
frac = frac - .2
money = money + 225000*frac*.13
if(frac > 0){
money = money + 225000*frac*.16
}
}
}}
return(money)
}
