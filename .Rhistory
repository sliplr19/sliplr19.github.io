str_detect(Method, "pd") ~ "Pdcor",
str_detect(Method, "pr") ~ "'Pearson\\'s'",
str_detect(Method, "sp") ~ "'Spearman\\'s'",
TRUE ~ NA_character_
)
)
datsensi <- rbind(sensAC, sensBCinter)
dat <- rbind(datsensi, datspec) %>%
filter(!is.na(Sensitivity) | !is.na(Specificity)) %>%
group_by(n, meanA, meanB, meanC, beta_lin, beta_con, beta_non,
beta_ab, func, group, Method, Method_Name, analysis_group) %>%
summarise(
Sensitivity = first(na.omit(Sensitivity)),
Specificity = first(na.omit(Specificity)),
.groups = "drop"
)
specBCquadlog <- countdat %>%
filter(node_group == "BC" & func != "inter") %>%
mutate(analysis_group = "BCquadlog") %>%
group_by(n, meanA, meanB, meanC, beta_lin, beta_con, beta_non,
beta_ab, func, group, analysis_group) %>%
summarize(
specCcmi = totTNCcmi / (totTNCcmi + totFPCcmi),
specCpd = totTNCpd / (totTNCpd + totFPCpd),
specCsp = totTNCsp / (totTNCsp + totFPCsp),
specCpr = case_when(!str_detect(group, "cent") ~ totTNCpr / (totTNCpr + totFPCpr), TRUE ~ NA_real_),
speccentcmi = totTNcentcmi / (totTNcentcmi + totFPcentcmi),
speccentpd = totTNcentpd / (totTNcentpd + totFPcentpd),
speccentsp = totTNcentsp / (totTNcentsp + totFPcentsp),
speccentpr = case_when(str_detect(group, "cent") ~ totTNcentpr / (totTNcentpr + totFPcentpr), TRUE ~ NA_real_),
speccmi = totTNcmi / (totTNcmi + totFPcmi),
specpd = totTNpd / (totTNpd + totFPpd),
specsp = totTNsp / (totTNsp + totFPsp),
specpr = case_when(!str_detect(group, "cent") ~ totTNpr / (totTNpr + totFPpr), TRUE ~ NA_real_)
) %>%
pivot_longer(cols = starts_with("spec"),
names_to = "Method",
values_to = "Specificity") %>%
mutate(
Sensitivity = NA,
Method_Name = case_when(
str_detect(Method, "cmi") ~ "CMI",
str_detect(Method, "pd") ~ "Pdcor",
str_detect(Method, "pr") ~ "'Pearson\\'s'",
str_detect(Method, "sp") ~ "'Spearman\\'s'",
TRUE ~ NA_character_
)
)
datspec <- specBCquadlog
sensAC <- countdat %>%
filter(node_group == "AC") %>%
mutate(analysis_group = "AC") %>%
group_by(n, meanA, meanB, meanC, beta_lin, beta_con, beta_non,
beta_ab, func, group, analysis_group) %>%
summarize(
sensiCcmi = totTPCcmi / (totTPCcmi + totFNCcmi),
sensiCpd = totTPCpd / (totTPCpd + totFNCpd),
sensiCpr = case_when(!str_detect(group, "cent") ~ totTPCpr / (totTPCpr + totFNCpr), TRUE ~ NA_real_),
sensiCsp = totTPCsp / (totTPCsp + totFNCsp),
sensicentcmi = totTPcentcmi / (totTPcentcmi + totFNcentcmi),
sensicentpd = totTPcentpd / (totTPcentpd + totFNcentpd),
sensicentpr = case_when(str_detect(group, "cent") ~ totTPcentpr / (totTPcentpr + totFNcentpr), TRUE ~ NA_real_),
sensicentsp = totTPcentsp / (totTPcentsp + totFNcentsp),
sensicmi = totTPcmi / (totTPcmi + totFNcmi),
sensipd = totTPpd / (totTPpd + totFNpd),
sensipr = case_when(!str_detect(group, "cent") ~ totTPpr / (totTPpr + totFNpr), TRUE ~ NA_real_),
sensisp = totTPsp / (totTPsp + totFNsp)
) %>%
pivot_longer(cols = starts_with("sensi"),
names_to = "Method",
values_to = "Sensitivity") %>%
mutate(
Specificity = NA,
Method_Name = case_when(
str_detect(Method, "cmi") ~ "CMI",
str_detect(Method, "pd") ~ "Pdcor",
str_detect(Method, "pr") ~ "'Pearson\\'s'",
str_detect(Method, "sp") ~ "'Spearman\\'s'",
TRUE ~ NA_character_
)
)
sensBCinter <- countdat %>%
filter(node_group == "BC" & func == "inter") %>%
mutate(analysis_group = "BCinter") %>%
group_by(n, meanA, meanB, meanC, beta_lin, beta_con, beta_non,
beta_ab, func, group, analysis_group) %>%
summarize(
sensiCcmi = totTPCcmi / (totTPCcmi + totFNCcmi),
sensiCpd = totTPCpd / (totTPCpd + totFNCpd),
sensiCpr = case_when(!str_detect(group, "cent") ~ totTPCpr / (totTPCpr + totFNCpr), TRUE ~ NA_real_),
sensiCsp = totTPCsp / (totTPCsp + totFNCsp),
sensicentcmi = totTPcentcmi / (totTPcentcmi + totFNcentcmi),
sensicentpd = totTPcentpd / (totTPcentpd + totFNcentpd),
sensicentpr = case_when(str_detect(group, "cent") ~ totTPcentpr / (totTPcentpr + totFNcentpr), TRUE ~ NA_real_),
sensicentsp = totTPcentsp / (totTPcentsp + totFNcentsp),
sensicmi = totTPcmi / (totTPcmi + totFNcmi),
sensipd = totTPpd / (totTPpd + totFNpd),
sensipr = case_when(!str_detect(group, "cent") ~ totTPpr / (totTPpr + totFNpr), TRUE ~ NA_real_),
sensisp = totTPsp / (totTPsp + totFNsp)
) %>%
pivot_longer(cols = starts_with("sensi"),
names_to = "Method",
values_to = "Sensitivity") %>%
mutate(
Specificity = NA,
Method_Name = case_when(
str_detect(Method, "cmi") ~ "CMI",
str_detect(Method, "pd") ~ "Pdcor",
str_detect(Method, "pr") ~ "'Pearson\\'s'",
str_detect(Method, "sp") ~ "'Spearman\\'s'",
TRUE ~ NA_character_
)
)
datsensi <- rbind(sensAC, sensBCinter)
dat <- rbind(datsensi, datspec) %>%
filter(!is.na(Sensitivity) | !is.na(Specificity)) %>%
group_by(n, meanA, meanB, meanC, beta_lin, beta_con, beta_non,
beta_ab, func, group, Method, Method_Name, analysis_group) %>%
summarise(
Sensitivity = first(na.omit(Sensitivity)),
